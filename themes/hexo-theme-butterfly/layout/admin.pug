//- 管理控制台 /admin/ —— 独立页面，不继承站点头尾
//- 进入方式：在检索栏输入管理员密钥（密钥哈希见 /custom/admin/admin-key.js）
doctype html
html(lang='zh-CN' data-theme='dark')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
    meta(name='robots' content='noindex,nofollow,noarchive')
    meta(name='referrer' content='no-referrer')
    title 管理控制台
    link(rel='stylesheet' href=url_for('/custom/assets/fontawesome/all.min.css'))
    link(rel='stylesheet' href=url_for('/custom/cursor/site-cursor.css'))
    //- 带版本号：静态托管对自定义资源无 cache-control，不加版本号浏览器会长期跑旧文件
    link(rel='stylesheet' href=url_for('/custom/admin/admin.css') + '?v=20260910i')
  body.admin-body
    //- ============ 背景：canvas 液态玻璃 + 星链 + 流星 ============
    canvas#admin-space(aria-hidden='true')

    //- ============ 门禁 ============
    #admin-gate.admin-gate
      .admin-gate-card
        .admin-gate-icon
          i.fas.fa-shield-halved
        h1 管理控制台
        p.admin-gate-desc 输入管理员密钥进入。也可以在站点检索栏输入密钥后<b>按回车</b>直接跳转。
        input#gate-key.admin-input(type='password' placeholder='XXXXX-XXXXX-XXXXX-XXXXX' autocomplete='off' spellcheck='false')
        button#gate-btn.admin-btn.admin-btn-primary(type='button') 进入
        #gate-msg.admin-gate-msg

    //- ============ 主界面 ============
    #admin-app.admin-app(style='display:none')
      header.admin-top
        .admin-brand
          span.adm-led
          i.fas.fa-satellite-dish
          span 管理控制台
        .admin-top-actions
          span#admin-repo.admin-repo —
          button#btn-home.admin-btn(type='button' title='返回站点首页')
            i.fas.fa-house
            span 首页
          button#btn-reload.admin-btn(type='button' title='重新拉取文章清单与元数据')
            i.fas.fa-rotate
            span 刷新
          button#btn-logout.admin-btn(type='button' title='退出登录')
            i.fas.fa-right-from-bracket
            span 退出

      nav#admin-tabs.admin-tabs
        button.admin-tab.is-active(type='button' data-tab='overview') 概览
        button.admin-tab(type='button' data-tab='posts') 文章
        button.admin-tab(type='button' data-tab='announce') 公告
        button.admin-tab(type='button' data-tab='copy') 站点文案
        button.admin-tab(type='button' data-tab='taxonomy') 标签 / 分类
        button.admin-tab(type='button' data-tab='archives') 归档
        button.admin-tab(type='button' data-tab='settings') 设置

      main.admin-main
        //- ---------- 概览 ----------
        section#tab-overview.admin-pane.is-active
          .admin-cards
            .admin-stat
              .admin-stat-num#stat-posts 0
              .admin-stat-label 篇文章
            .admin-stat
              .admin-stat-num#stat-tags 0
              .admin-stat-label 个标签
            .admin-stat
              .admin-stat-num#stat-cats 0
              .admin-stat-label 个分类
            .admin-stat
              .admin-stat-num#stat-months 0
              .admin-stat-label 个月份归档
          .admin-panel
            .admin-panel-title 最近更新
            #overview-recent.admin-list

        //- ---------- 文章 ----------
        section#tab-posts.admin-pane
          #posts-list-view
            .admin-toolbar
              input#posts-filter.admin-input(type='text' placeholder='筛选标题 / 标签 / 分类…')
              button#btn-new-post.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-plus
                span 新建文章
            #posts-list.admin-list
          #post-editor-view(style='display:none')
            .admin-toolbar
              button#btn-back-list.admin-btn(type='button')
                i.fas.fa-arrow-left
                span 返回列表
              .admin-editor-file#editor-file
              span#editor-state.admin-editor-state
            .admin-editor
              #editor-draft.editor-draft(style='display:none')
                i.fas.fa-clock-rotate-left
                span#editor-draft-text 检测到本地草稿
                button#btn-restore-draft.editor-draft-btn(type='button') 恢复
                button#btn-drop-draft.editor-draft-btn(type='button') 忽略
              .admin-form
                .admin-field
                  label 标题
                  input#ed-title.admin-input.admin-input-lg(type='text' placeholder='给这篇文章起个标题…')
                .admin-row
                  .admin-field
                    label 日期（YYYY-MM-DD HH:mm:ss）
                    input#ed-date.admin-input(type='text')
                  .admin-field
                    label 置顶权重
                    .admin-sticky-row
                      input#ed-sticky.admin-input(type='number' min='0' step='1')
                      span#sticky-state.admin-sticky-state
                    .admin-field-hint
                      | 数字<b>越小越靠前</b>（<b>1 = 最前</b>）；<b>0 = 不置顶</b>，按日期倒序排在普通文章里。
                      | 数字相同的置顶文章之间再按日期倒序。
                .admin-row
                  .admin-field
                    label 分类（逗号分隔）
                    input#ed-categories.admin-input(type='text' placeholder='如：教程, Hexo')
                  .admin-field
                    label 标签（逗号分隔）
                    input#ed-tags.admin-input(type='text' placeholder='如：Terraria, 模组')
                .admin-field
                  label 摘要 / description（可空，用于列表页与搜索引擎）
                  input#ed-desc.admin-input(type='text')
                .admin-field
                  label 正文（Markdown）
                  .editor-body.mode-edit#editor-body
                    .editor-bar
                      .editor-tools
                        button.editor-tool(type='button' data-act='undo' title='撤回（Ctrl+Z）')
                          i.fas.fa-rotate-left
                        button.editor-tool(type='button' data-act='redo' title='重做（Ctrl+Shift+Z / Ctrl+Y）')
                          i.fas.fa-rotate-right
                        span.editor-tools-sep
                        button.editor-tool(type='button' data-md='bold' title='加粗（Ctrl+B）')
                          i.fas.fa-bold
                        button.editor-tool(type='button' data-md='italic' title='斜体（Ctrl+I）')
                          i.fas.fa-italic
                        button.editor-tool(type='button' data-md='strike' title='删除线')
                          i.fas.fa-strikethrough
                        span.editor-tools-sep
                        button.editor-tool(type='button' data-md='h2' title='二级标题')
                          i.fas.fa-heading
                        button.editor-tool(type='button' data-md='quote' title='引用')
                          i.fas.fa-quote-left
                        button.editor-tool(type='button' data-md='ul' title='无序列表')
                          i.fas.fa-list-ul
                        button.editor-tool(type='button' data-md='ol' title='有序列表')
                          i.fas.fa-list-ol
                        span.editor-tools-sep
                        button.editor-tool(type='button' data-md='code' title='行内代码')
                          i.fas.fa-code
                        button.editor-tool(type='button' data-md='codeblock' title='代码块')
                          i.fas.fa-file-code
                        button.editor-tool(type='button' data-md='link' title='链接（Ctrl+K）')
                          i.fas.fa-link
                        button.editor-tool(type='button' data-md='image' title='插入图片：选文件上传到仓库（或直接把图片粘贴 / 拖进来）')
                          i.fas.fa-image
                        button.editor-tool(type='button' data-md='image-url' title='插入外链图片（手填图片网址）')
                          i.fas.fa-link
                        button.editor-tool(type='button' data-md='table' title='表格')
                          i.fas.fa-table
                        button.editor-tool(type='button' data-md='hr' title='分割线')
                          i.fas.fa-minus
                      .editor-modes
                        button.editor-mode.is-active(type='button' data-mode='edit') 编辑
                        button.editor-mode(type='button' data-mode='split') 分栏
                        button.editor-mode(type='button' data-mode='preview') 预览
                    .editor-panes
                      textarea#ed-body.admin-textarea(rows='22' spellcheck='false' placeholder='用 Markdown 写正文…')
                      .editor-preview#editor-preview
                    input#ed-image-file(type='file' accept='image/*' multiple hidden)
                    .editor-foot
                      span#ed-stats.editor-stats 0 字 · 0 行 · 约 1 分钟
                      span.editor-tip Ctrl+B 加粗 · Ctrl+K 链接 · Ctrl+S 保存 · Tab 缩进 · 插入图片：点图钉选文件，或直接 Ctrl+V 粘贴 / 拖图片进来
                .admin-actions
                  button#btn-save-post.admin-btn.admin-btn-primary(type='button')
                    i.fas.fa-floppy-disk
                    span 保存到仓库
                  button#btn-delete-post.admin-btn.admin-btn-danger(type='button')
                    i.fas.fa-trash
                    span 删除文章
                  button#btn-cancel-edit.admin-btn(type='button') 取消

        //- ---------- 公告 ----------
        section#tab-announce.admin-pane
          .admin-panel
            .admin-panel-title 侧栏公告内容
            .admin-editor-head
              span#announce-state.admin-editor-state
              #announce-draft.editor-draft(style='display:none')
                i.fas.fa-clock-rotate-left
                span#announce-draft-text 检测到本地草稿
                button#btn-restore-announce-draft.editor-draft-btn(type='button') 恢复
                button#btn-drop-announce-draft.editor-draft-btn(type='button') 忽略
            .editor-body.mode-edit#announce-editor(data-editor='announce')
              .editor-bar
                .editor-tools
                  button.editor-tool(type='button' data-act='undo' title='撤回（Ctrl+Z）')
                    i.fas.fa-rotate-left
                  button.editor-tool(type='button' data-act='redo' title='重做（Ctrl+Shift+Z / Ctrl+Y）')
                    i.fas.fa-rotate-right
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='bold' title='加粗（Ctrl+B）')
                    i.fas.fa-bold
                  button.editor-tool(type='button' data-md='italic' title='斜体（Ctrl+I）')
                    i.fas.fa-italic
                  button.editor-tool(type='button' data-md='strike' title='删除线')
                    i.fas.fa-strikethrough
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='h2' title='二级标题')
                    i.fas.fa-heading
                  button.editor-tool(type='button' data-md='quote' title='引用')
                    i.fas.fa-quote-left
                  button.editor-tool(type='button' data-md='ul' title='无序列表')
                    i.fas.fa-list-ul
                  button.editor-tool(type='button' data-md='ol' title='有序列表')
                    i.fas.fa-list-ol
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='code' title='行内代码')
                    i.fas.fa-code
                  button.editor-tool(type='button' data-md='link' title='链接（Ctrl+K）')
                    i.fas.fa-link
                  button.editor-tool(type='button' data-md='image' title='插入图片：选文件上传到仓库（或直接把图片粘贴 / 拖进来）')
                    i.fas.fa-image
                  button.editor-tool(type='button' data-md='image-url' title='插入外链图片（手填图片网址）')
                    i.fas.fa-link
                  button.editor-tool(type='button' data-md='hr' title='分割线')
                    i.fas.fa-minus
                .editor-modes
                  button.editor-mode.is-active(type='button' data-mode='edit') 编辑
                  button.editor-mode(type='button' data-mode='split') 分栏
                  button.editor-mode(type='button' data-mode='preview') 预览
              .editor-panes
                textarea#announce-body.admin-textarea(rows='12' spellcheck='false' placeholder='写侧栏公告：Markdown（**加粗**、- 列表、[链接](https://…)）或 HTML 标签都行，可以混用')
                .editor-preview#announce-preview
              input#announce-image-file(type='file' accept='image/*' multiple hidden)
              .editor-foot
                span#announce-stats.editor-stats 0 字 · 0 行
                span.editor-tip Ctrl+B 加粗 · Ctrl+K 链接 · Ctrl+S 保存 · Tab 缩进 · 插入图片：点图钉选文件，或直接 Ctrl+V 粘贴 / 拖图片进来
            .admin-actions
              button#btn-save-announce.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-floppy-disk
                span 保存公告
              button#btn-reload-announce.admin-btn(type='button') 重新拉取
              button#btn-clear-announce.admin-btn(type='button') 清空
            .admin-hint 保存后写入 <code>source/_data/announcement.yml</code>。站点用 <b>Markdown</b> 渲染这段内容（底层 marked）：工具栏写的 <code>**加粗**</code>、<code>- 列表</code>、<code>[链接](…)</code> 都会生效，<b>HTML 标签原样保留</b>，两种写法可混用；预览为近似效果，最终以构建后的侧栏为准。图片会自动上传到 <code>source/img/announce/</code> 并以 <code>/img/announce/…</code> 引用。

        //- ---------- 站点文案 ----------
        section#tab-copy.admin-pane
          .admin-panel
            .admin-panel-title 关于页正文
            .admin-editor-head
              span#about-state.admin-editor-state
            .editor-body.mode-edit#about-editor(data-editor='about')
              .editor-bar
                .editor-tools
                  button.editor-tool(type='button' data-act='undo' title='撤回（Ctrl+Z）')
                    i.fas.fa-rotate-left
                  button.editor-tool(type='button' data-act='redo' title='重做（Ctrl+Shift+Z / Ctrl+Y）')
                    i.fas.fa-rotate-right
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='bold' title='加粗（Ctrl+B）')
                    i.fas.fa-bold
                  button.editor-tool(type='button' data-md='italic' title='斜体（Ctrl+I）')
                    i.fas.fa-italic
                  button.editor-tool(type='button' data-md='strike' title='删除线')
                    i.fas.fa-strikethrough
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='h2' title='二级标题')
                    i.fas.fa-heading
                  button.editor-tool(type='button' data-md='quote' title='引用')
                    i.fas.fa-quote-left
                  button.editor-tool(type='button' data-md='ul' title='无序列表')
                    i.fas.fa-list-ul
                  button.editor-tool(type='button' data-md='ol' title='有序列表')
                    i.fas.fa-list-ol
                  span.editor-tools-sep
                  button.editor-tool(type='button' data-md='code' title='行内代码')
                    i.fas.fa-code
                  button.editor-tool(type='button' data-md='link' title='链接（Ctrl+K）')
                    i.fas.fa-link
                  button.editor-tool(type='button' data-md='image' title='插入图片：选文件上传到仓库（或直接把图片粘贴 / 拖进来）')
                    i.fas.fa-image
                  button.editor-tool(type='button' data-md='image-url' title='插入外链图片（手填图片网址）')
                    i.fas.fa-link
                  button.editor-tool(type='button' data-md='hr' title='分割线')
                    i.fas.fa-minus
                .editor-modes
                  button.editor-mode.is-active(type='button' data-mode='edit') 编辑
                  button.editor-mode(type='button' data-mode='split') 分栏
                  button.editor-mode(type='button' data-mode='preview') 预览
              .editor-panes
                textarea#about-body.admin-textarea(rows='18' spellcheck='false' placeholder='写关于页正文（Markdown）。「关于本站 / 版权声明 / 免责声明」这些小节都在这里，可以直接改。')
                .editor-preview#about-preview
              input#about-image-file(type='file' accept='image/*' multiple hidden)
              .editor-foot
                span#about-stats.editor-stats 0 字 · 0 行
                span.editor-tip Ctrl+B 加粗 · Ctrl+K 链接 · Ctrl+S 保存 · Tab 缩进 · 插图：点图钉选文件，或 Ctrl+V 粘贴 / 拖进来
            .admin-actions
              button#btn-save-about.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-floppy-disk
                span 保存关于页
              button#btn-reload-copy.admin-btn(type='button') 重新拉取
            .admin-hint 保存后写入 <code>source/about/index.md</code>。页头的 front-matter（标题、日期、<code>comments: false</code>）会<b>原样保留</b>，正文由这里覆盖；图片自动上传到 <code>source/img/about/</code>。

          .admin-panel
            .admin-panel-title 站点文案（根 <code>_config.yml</code>）
            .admin-form
              .admin-field
                label(for='copy-subtitle') 站点副标题（subtitle）
                input#copy-subtitle.admin-input(type='text' placeholder='写点代码，也写点生活')
                .admin-field-hint 用于浏览器标签页标题、分享卡片等位置
              .admin-field
                label(for='copy-description') 站点简介（description）
                input#copy-description.admin-input(type='text' placeholder='Terraria 模组开发 / 前端折腾 / 一些不想忘掉的笔记')
                .admin-field-hint 用于首页 meta 描述与搜索结果摘要
            .admin-actions
              button#btn-save-site.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-floppy-disk
                span 保存站点文案

          .admin-panel
            .admin-panel-title 主题文案（首页标语 / 作者卡片）
            .admin-form
              .admin-field
                label(for='copy-subtitle-lines') 首页打字机标语（一行一句）
                textarea#copy-subtitle-lines.admin-textarea(rows='4' spellcheck='false' placeholder='写点代码，也写点生活')
                .admin-field-hint 首页「纪元」下面轮流打出来的那几句，改几行就轮播几句
              .admin-field
                label(for='copy-author-desc') 作者卡片简介
                input#copy-author-desc.admin-input(type='text' placeholder='写点代码，也写点生活 ✨')
            .admin-actions
              button#btn-save-theme.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-floppy-disk
                span 保存主题文案
            .admin-hint 这两项属于主题配置（<code>themes/hexo-theme-butterfly/_config.yml</code>）。后台只改这两处文本，<b>文件里其它配置与注释一律不动</b>。

        //- ---------- 标签 / 分类 ----------
        section#tab-taxonomy.admin-pane
          .admin-panel
            .admin-panel-title 标签
            #tax-tags.admin-tax
          .admin-panel
            .admin-panel-title 分类
            #tax-cats.admin-tax
          .admin-hint 重命名 / 删除会改写所有相关文章的 front-matter，逐篇提交到仓库。

        //- ---------- 归档 ----------
        section#tab-archives.admin-pane
          #archives-view.admin-list

        //- ---------- 设置 ----------
        section#tab-settings.admin-pane
          .admin-panel
            .admin-panel-title GitHub 写入凭证
            .admin-hint
              | 管理页的增删改都通过 GitHub Contents API 完成，需要一枚
              a(href='https://github.com/settings/personal-access-tokens/new' target='_blank' rel='noopener') 细粒度 PAT
              | ：仅授权本仓库，权限只需 <b>Contents: Read and write</b>。
              | Token 用可逆混淆编码后只存在本机浏览器，不会写进源码。
            .admin-row
              .admin-field
                label 仓库所有者
                input#gh-owner.admin-input(type='text' placeholder='008heshan')
              .admin-field
                label 仓库名
                input#gh-name.admin-input(type='text' placeholder='hexshane-blog')
            .admin-row
              .admin-field
                label 分支
                input#gh-branch.admin-input(type='text' placeholder='main')
              .admin-field
                label GitHub Token（ghp_ / github_pat_…）
                input#gh-token.admin-input(type='password' autocomplete='off' spellcheck='false')
            .admin-actions
              button#btn-save-gh.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-floppy-disk
                span 保存凭证
              button#btn-test-gh.admin-btn(type='button') 测试连接
              button#btn-clear-gh.admin-btn.admin-btn-danger(type='button') 清除凭证
            #gh-status.admin-hint

          .admin-panel
            .admin-panel-title 修改管理员密钥
            .admin-hint
              | 新密钥会以 SHA-256 哈希写入 <code>source/custom/admin/admin-key.js</code>，
              | 提交后需重新构建站点；旧密钥立即失效。
            .admin-row
              .admin-field
                label 新密钥（建议 4 组 5 位，如 XXXXX-XXXXX-XXXXX-XXXXX）
                input#new-admin-key.admin-input(type='password' autocomplete='off' spellcheck='false')
            .admin-actions
              button#btn-save-admin-key.admin-btn.admin-btn-primary(type='button')
                i.fas.fa-key
                span 提交新密钥

    .admin-toast#admin-toast

    script(src=url_for('/custom/cursor/site-cursor.js'))
    script(src=url_for('/custom/admin/admin-key.js'))
    script(src=url_for('/custom/admin/admin-space.js'))
    script(src=url_for('/custom/admin/admin.js') + '?v=20260910r')
